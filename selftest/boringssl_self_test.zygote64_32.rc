on early-init && property:ro.product.cpu.abilist32=*
    start boringssl_self_test32_vendor

on early-init && property:ro.product.cpu.abilist64=*
    start boringssl_self_test64_vendor

on post-early-init && property:ro.product.cpu.abilist32=*
    wait_for_prop init.svc.boringssl_self_test32_vendor "stopped"

on post-early-init && property:ro.product.cpu.abilist64=*
    wait_for_prop init.svc.boringssl_self_test64_vendor "stopped"
